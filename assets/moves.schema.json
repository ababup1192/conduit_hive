{
  "//": "conduit_hive.moves.json の形（Studio の sections 方言）。既定は src/MovesDoc.flix の defaults() が正。",
  "version": 1,
  "sections": {
    "stamina": {
      "kind": "record",
      "label": "スタミナ",
      "order": 1,
      "fields": {
        "max": {
          "type": "float",
          "label": "最大",
          "order": 1,
          "default": 100.0,
          "min": 1,
          "max": 1000
        },
        "regenPerSecond": {
          "type": "float",
          "label": "使わない間に戻る速さ（/秒）",
          "order": 2,
          "default": 28.0,
          "min": 0,
          "max": 500
        },
        "regenDelay": {
          "type": "float",
          "label": "最後に使ってから戻り始めるまで（秒）",
          "order": 3,
          "default": 0.9,
          "min": 0,
          "max": 5
        },
        "resumeAt": {
          "type": "float",
          "label": "息切れの後に走れるまで戻る量",
          "order": 4,
          "default": 35.0,
          "min": 0,
          "max": 1000
