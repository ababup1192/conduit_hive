        "seconds": {
          "type": "float",
          "label": "脚が見えている長さ（秒）",
          "order": 9,
          "default": 0.42,
          "min": 0.05,
          "max": 2
        },
        "shake": {
          "type": "float",
          "label": "camera shake の強さ（0..1）",
          "order": 10,
          "default": 0.45,
          "min": 0,
          "max": 1
        }
      }
    }
  }
}
