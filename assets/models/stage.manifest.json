  "uv1": "lightmap (TEXCOORD_1), one PNG per zone",
  "lightmap_encoding": "png = srgb_encode(clamp(0.25 * linear, 0, 1)) + ambient [0.035, 0.04, 0.046] already added; use Scene3d.lightmap intensity 4.0 (x exposure if wanted)",
